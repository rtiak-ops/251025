# ==============================================================================
# 環境設定テンプレート (.env.example)
# ==============================================================================
# このファイルを `.env` にコピーして、実際の値を設定してください。
# `cp .env.example .env`

# --- データベース設定 ---
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_db_name

# --- バックエンド設定 ---
DATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@db:5432/your_db_name
SECRET_KEY=generate_a_random_hex_string_here
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# development or production
ENV=development
DEBUG=true

# JWT設定
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS設定（カンマ区切りで複数指定可能）
# CORS_ORIGINS=https://example.com,https://www.example.com

# --- フロントエンド設定 ---
DOMAIN_NAME=localhost
