# -----------------------------------------------------------
# 1. 土台となる「OSとPython」を準備します
# -----------------------------------------------------------
# Python 3.13（最新の安定版）の軽量パッケージ（slim）を選びました。
# 余計なものが入っていないので、動きが軽く、セキュリティ面でも安心です。
FROM python:3.13-slim

# -----------------------------------------------------------
# 2. 作業する「お部屋」を決めます
# -----------------------------------------------------------
# コンテナの中に「/app」という名前のフォルダを作って、そこでお仕事をするように設定します。
WORKDIR /app

# -----------------------------------------------------------
# 3. 必要なライブラリ（道具）を揃えます
# -----------------------------------------------------------
# まずは、インストールに必要な「リスト（requirements.txt）」だけを先に運び込みます。
# こうすることで、プログラムだけを書き換えたときに、時間の重いインストール作業をスキップ（キャッシュ）できます。
COPY requirements.txt .

# リストをもとに、ライブラリをインストールします。
# --no-cache-dir：インストール後に不要なゴミを残さず、コンテナをスリムに保ちます。
# --default-timeout=1000：ネットが少し遅くても、焦らずゆっくりダウンロードを待つ設定です。
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.txt

# -----------------------------------------------------------
# 4. あなたの作った「プログラム」を運び込みます
# -----------------------------------------------------------
# 道具が揃ったら、最後に「app」フォルダの中身を丸ごとコンテナにコピーします。
COPY ./app ./app

# -----------------------------------------------------------
# 5. いよいよアプリケーションを動かします！
# -----------------------------------------------------------
# Uvicorn（サーバー）を使って、FastAPIなどのアプリを起動します。
# --host 0.0.0.0：コンテナの外（ブラウザなど）からも見られるようにします。
# --port 8000：8000番の窓口でリクエストを待ち受けます。
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]