# -----------------------------------------------------------
# 1. 土台となる「OSとPython」を準備します
# -----------------------------------------------------------
# Python 3.13（最新の安定版）の軽量パッケージ（slim）を選びました。
# 余計なものが入っていないので、動きが軽く、セキュリティ面でも安心です。
FROM python:3.13-slim

# -----------------------------------------------------------
# 2. 作業する「お部屋」を決めます
# -----------------------------------------------------------
# コンテナの中に「/app」という名前のフォルダを作って、そこでお仕事をするように設定します。
WORKDIR /app

# -----------------------------------------------------------
# 3. 必要なライブラリ（道具）を揃えます
# -----------------------------------------------------------
# まずは、インストールに必要な「リスト（requirements.txt）」だけを先に運び込みます。
# こうすることで、プログラムだけを書き換えたときに、時間の重いインストール作業をスキップ（キャッシュ）できます。
COPY requirements.txt .

# リストをもとに、ライブラリをインストールします。
# --no-cache-dir：インストール後に不要なゴミを残さず、コンテナをスリムに保ちます。
# --default-timeout=1000：ネットが少し遅くても、焦らずゆっくりダウンロードを待つ設定です。
RUN pip install --default-timeout=1000 --no-cache-dir -r requirements.txt

# -----------------------------------------------------------
# 4. あなたの作った「プログラム」を運び込みます
# -----------------------------------------------------------
# 道具が揃ったら、最後に「app」フォルダの中身を丸ごとコンテナにコピーします。
COPY ./app ./app

# -----------------------------------------------------------
# 5. セキュリティ対策: 非特権ユーザーの作成
# -----------------------------------------------------------
# rootユーザーで実行すると、万が一アプリに脆弱性があった場合に
# コンテナ全体やホストOSに被害が及ぶリスクがあります。
# 専用のユーザー（appuser）を作成し、その権限で実行します。
RUN groupadd -r appgroup && useradd -r -g appgroup appuser
RUN chown -R appuser:appgroup /app
USER appuser

# 環境変数の設定
# Pythonがログをリアルタイムで出力するように設定（バッファリング無効）
ENV PYTHONUNBUFFERED=1
# .pycファイルの生成を抑制
ENV PYTHONDONTWRITEBYTECODE=1
# 本番環境フラグ (必要に応じて上書き)
ENV ENV=production

# -----------------------------------------------------------
# ヘルスチェック設定
# -----------------------------------------------------------
# コンテナが正常に動作しているかを定期的に確認します
# interval: 30秒ごとにチェック
# timeout: 10秒以内に応答がなければ失敗
# retries: 3回連続で失敗したら unhealthy と判定
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

# -----------------------------------------------------------
# 6. いよいよアプリケーションを動かします！
# -----------------------------------------------------------
# Uvicorn（サーバー）を使って、FastAPIなどのアプリを起動します。
# --host 0.0.0.0：コンテナの外（ブラウザなど）からも見られるようにします。
# --port 8000：8000番の窓口でリクエストを待ち受けます。
# workers: 複数プロセスで並列処理（本番用）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]