# 1. 土台となるイメージの選択
# Node.jsの最新版（23）をベースに使います。新しい機能やパフォーマンス向上が期待できます。
FROM node:23

# 2. コンテナ内での「作業机」を決める
# これ以降のコマンドはすべて /app ディレクトリの中で実行されます。
WORKDIR /app

# 3. 依存リストだけを先にコピー（効率化のポイント！）
# ソースコード全部ではなく、まずは npm install に必要なファイルだけを移します。
# こうすることで、コードを書き換えるたびに重いインストールが走るのを防げます（キャッシュの活用）。
COPY package*.json ./

# 4. 必要なライブラリをインストール
# package-lock.jsonの内容に基づき、正確に依存関係を再現してインストールします。
RUN npm install

# 5. 残りのプログラム（ソースコード）をすべてコピー
# ライブラリの準備ができたので、自作のコードをコンテナの中に流し込みます。
COPY . .

# 6. 「このドア（ポート）を使います」という宣言
# Viteのデフォルトポートである3000番を、外の世界と繋げられるように開けておきます。
EXPOSE 3000

# 7. アプリを起動！
# --host 0.0.0.0 を付けることで、コンテナの外側（ブラウザなど）から
# アプリにアクセスできるようになります。
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]