server {
    listen 80;
    server_name localhost;

    # フロントエンドの静的ファイル
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # バックエンドAPIへのプロキシ (認証)
    location /auth/ {
        proxy_pass ${BACKEND_URL}/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # バックエンドAPIへのプロキシ (Todo操作)
    location /todos/ {
        proxy_pass ${BACKEND_URL}/todos/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # バックエンドAPIへのプロキシ (AI機能)
    location /ai/ {
        proxy_pass ${BACKEND_URL}/ai/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # APIドキュメント (Swagger UI) 用
    location /docs {
        proxy_pass ${BACKEND_URL}/docs;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass ${BACKEND_URL}/openapi.json;
        proxy_set_header Host $host;
    }
}
